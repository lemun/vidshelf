# Template for .env. Do not copy it by hand: run `scripts/gen-env.sh`, which writes .env from this
# file and fills in the four secrets below with random values. The secrets are deliberately empty
# here: the API and docker compose both refuse to start without them.
# Read by `docker compose` (variable substitution) and by `npm run dev` (the API).

PORT=3000
MONGO_URI=mongodb://localhost:27017/vidshelf

# JWT secrets: at least 32 characters each, and different from each other. Generated.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# bcrypt cost: 10 to 15.
BCRYPT_ROUNDS=12
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# Requests per minute per IP on /api/auth/*.
AUTH_RATE_LIMIT=20

# MinIO (S3-compatible). The API talks to MINIO_ENDPOINT:MINIO_PORT; browsers use MINIO_PUBLIC_URL,
# so presigned URLs must be signed for the public URL. In docker compose the access key and secret
# are also MinIO's root user and password. Generated.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=vidshelf
MINIO_PUBLIC_URL=http://localhost:9000
MAX_UPLOAD_MB=200
