# Local development defaults only. Every value here is safe to publish and MUST be changed
# for any deployment that is reachable by other people.
# Used by `npm run dev` (copy to .env). `docker compose up` has the same defaults built in.

PORT=3000
MONGO_URI=mongodb://localhost:27017/vidshelf

# JWT secrets: at least 32 characters each, and different from each other.
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=10
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# Requests per minute per IP on /api/auth/*.
AUTH_RATE_LIMIT=20

# MinIO (S3-compatible). The API talks to MINIO_ENDPOINT:MINIO_PORT; browsers use MINIO_PUBLIC_URL,
# so presigned URLs must be signed for the public URL.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vidshelf
MINIO_PUBLIC_URL=http://localhost:9000
MAX_UPLOAD_MB=200
